#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "../common/keycode_japanese.h"
#include "../common/behaviors.dtsi"
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>

/ {
     conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    behaviors {
        /* Guard the mouse pair/unpair keys behind Shift, so a stray press on
           the adjust layer can't drop or re-pair the mouse. Without Shift they
           are a no-op; with Shift held they run the real behavior. */
        mouse_pair_shift: mouse_pair_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&mouse_pair>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mouse_unpair_shift: mouse_unpair_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&none>, <&mouse_unpair>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* Thumb Ctrl keys: hold = Ctrl, tap = IME switch + base-layer switch.
           US: LANG2 (英数) + layer 0 / JA: LANG1 (かな) + layer 1 (AZIK). */
        ctl_us: ctl_us {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&lang_us>;
        };
        ctl_ja: ctl_ja {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            bindings = <&kp>, <&lang_ja>;
        };

        /* JA-mode raise key: hold = raise layer, tap = Ctrl-M.
           hold-preferred: any other key pressed while held makes it the layer. */
        raise_cm: raise_cm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        lang_us: lang_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&to 0>;
        };
        lang_ja: lang_ja {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&to 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "US";
            // --- ---  w   e   r   t           y   u   i   o  --- ---
            //  q   a   s   d   f   g           h   j   k   l   p   @
            //  _   z   x   c   v   b           n   m   ,   .   /   \
            //         ALT GUI SFT LOW CTL CTL RIS SFT GUI ALT
            //         ESC DEL TAB     EIS KAN     SPC BSP ENT

            bindings = <
                &none &none &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &none &none
                &kp Q &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp P &kp JP_AT
                &kp JP_UNDER &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp JP_COMMA &kp JP_DOT &kp JP_SLASH &kp JP_YEN
                &none
                &mt LALT ESC &mt LGUI DEL &mt LSHFT TAB &mo 2 &ctl_us LCTL 0
                &ctl_ja RCTL 0 &mo 3 &mt RSHFT SPACE &mt RGUI BSPC &mt RALT ENTER
                &none
            >;
        };

        ja_layer {
            display-name = "JA (AZIK)";
            // Same as US except:  @ -> ; (AZIK: っ)   \ -> : (AZIK: ー)
            //                     RIS tap -> Ctrl-M (hold is still raise)
            // --- --- ___ ___ ___ ___         ___ ___ ___ ___ --- ---
            // ___ ___ ___ ___ ___ ___         ___ ___ ___ ___ ___  ;
            // ___ ___ ___ ___ ___ ___         ___ ___ ___ ___ ___  :
            //         ___ ___ ___ ___ ___ ___ C-m ___ ___ ___

            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp JP_SEMI
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp JP_COLON
                &trans
                &trans &trans &trans &trans &trans
                &trans &raise_cm 3 LC(M) &trans &trans &trans
                &trans
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            // --- --- --- --- --- ---         --- --- --- --- --- ---
            //  1   2   3   4   5   6           7   8   9   0   -   ^
            // --- --- --- --- --- ---          ;   :   [   ]  (@) (\)
            //         ___ ___ ___ ___ ___ ___ ___ ___ ___ ___

            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp JP_MINUS &kp JP_CARET
                &none &none &none &none &none &none &kp JP_SEMI &kp JP_COLON &kp JP_LBKT &kp JP_RBKT &kp JP_AT &kp JP_YEN
                &none
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &none
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            // --- --- --- --- --- ---         --- --- --- --- --- ---
            // --- --- --- HOM END INS         <<< vvv ^^^ >>> Pvv P^^
            // F1  F2  F3  F4  F5  F6          F7  F8  F9  F1O F11 F12
            //         ___ ___ ___ ___ ___ ___ ___ ___ ___ ___

            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &kp HOME &kp END &kp INS &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_DN &kp PG_UP
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &none
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &none
            >;
        };

        adjust_layer {
            display-name = "Adjust Layer";
            // --- --- USB BT0 BT1 BT2         BT3 BT4 CLR CLRALL --- --- (BT_DESC 0~4 : SHIFT + BT0~4)
            // BDP MP  MUP --- --- ---         MUT Vvv v^^ --- --- ---
            // ON  OFF EFF EFR HUD HUI         SAI SAD BRI BRD SPI SPD
            //         ___ ___ ___ ___ ___ ___ ___ ___ ___ ___

            bindings = <
                &none &none &sel_usb &sel_ble0 &sel_ble1 &sel_ble2 &sel_ble3 &sel_ble4 &bt BT_CLR &bt BT_CLR_ALL &none &none
                &bond_dump_act &mouse_pair_shift &mouse_unpair_shift &none &none &none &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none &none &none
                &rgb_ug RGB_ON &rgb_ug RGB_OFF &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_SPI &rgb_ug RGB_SPD
                &none
                &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans
                &none
            >;
        };

    };
};